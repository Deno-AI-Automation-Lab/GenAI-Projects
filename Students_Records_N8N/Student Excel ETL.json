    {
      "parameters": {
        "promptType": "define",
        "text": "=Clean this student enrollment row and return ONLY a JSON object.\n\nRow data: {{ JSON.stringify($json) }}\n\nRules:\n- Name: Title Case (Manoj K)\n- Email: if invalid set INVALID_EMAIL. If no entry found set MISSING\n- Phone: if less than 10 digits set MISSING. If no entry found set MISSING\n- Course: only Python or Machine Learning or Data Science. If no entry found set MISSING\n- Fee_Paid: yes/YES = true, no/NO = false. If no entry found set MISSING\n- City: Title Case, empty = UNKNOWN\n- Enrolled_Date: convert to YYYY-MM-DD. If no entry found set UNKNOWN\nTrim whitespace, fix inconsistent capitalisation\n\nReturn ONLY raw JSON, No explanation, No markdown.",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
