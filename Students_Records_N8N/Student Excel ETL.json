    {
      "parameters": {
        "jsCode": "// n8n Code node — Mode: Run Once for All Items\nconst items = $input.all();\nconst results = [];\n\n// ---------- placeholders the LLM uses ----------\nconst PLACEHOLDERS = ['MISSING', 'UNKNOWN', 'INVALID_EMAIL', 'N/A', 'NA', 'NULL', 'NONE'];\nconst isPlaceholder = v => PLACEHOLDERS.includes(String(v ?? '').trim().toUpperCase());\n\n// ---------- helpers ----------\nfunction getRaw(json) {\n  return json.output ?? json.text ?? json.response ??\n         json.message?.content ?? json.choices?.[0]?.message?.content ??\n         json.content ?? json;\n}\n\n// Parses normal, fenced (```json) and double-encoded JSON strings\nfunction parseAI(raw) {\n  let data = raw;\n  for (let i = 0; i < 3 && typeof data === 'string'; i++) {\n    let s = data.replace(/```(?:json)?/gi, '').trim();\n    const start = s.search(/[\\[{\"]/);\n    if (start > 0) s = s.slice(start);\n    s = s.replace(/,\\s*([}\\]])/g, '$1');   // trailing commas\n    data = JSON.parse(s);\n  }\n  if (typeof data !== 'object' || data === null) throw new Error('Output is not a JSON object');\n  return data;\n}\n\n// Title Case, but keep placeholders like MISSING / UNKNOWN in caps\nconst titleCase = v => {\n  if (v === null || v === undefined || String(v).trim() === '') return 'MISSING';\n  if (isPlaceholder(v)) return String(v).trim().toUpperCase();\n  return String(v).trim().toLowerCase().replace(/\\s+/g, ' ')\n    .replace(/\\b\\w/g, c => c.toUpperCase());\n};\n\nfunction cleanEmail(v, issues) {\n  const e = v ? String(v).trim().toLowerCase() : '';\n  if (/^[^\\s@]+@[^\\s@]+\\.[a-z]{2,}$/.test(e)) return e;\n  issues.push(`Invalid email: ${v || 'empty'}`);\n  return v ? String(v).trim() : 'INVALID_EMAIL';\n}\n\nfunction cleanPhone(v, issues) {\n  let p = String(v ?? '').replace(/\\D/g, '');\n  if (p.length === 12 && p.startsWith('91')) p = p.slice(2);   // +91\n  if (p.length === 11 && p.startsWith('0')) p = p.slice(1);\n  if (/^[6-9]\\d{9}$/.test(p)) return p;\n  issues.push(`Invalid phone: ${v || 'empty'}`);\n  return v ? String(v).trim() : 'MISSING';\n}\n\nfunction cleanBool(v, issues) {\n  if (typeof v === 'boolean') return v;\n  const s = String(v ?? '').trim().toLowerCase();\n  if (['yes', 'y', 'true', 'paid', '1'].includes(s)) return true;\n  if (['no', 'n', 'false', 'unpaid', '0'].includes(s)) return false;\n  issues.push(`Unclear Fee_Paid: ${v || 'empty'}`);\n  return v ? String(v).trim() : 'UNKNOWN';\n}\n\n// Accepts YYYY-MM-DD, DD-MM-YYYY, DD/MM/YYYY → returns YYYY-MM-DD\nfunction cleanDate(v, issues) {\n  const s = String(v ?? '').trim();\n  let y, m, d, match;\n  if ((match = s.match(/^(\\d{4})[-/.](\\d{1,2})[-/.](\\d{1,2})$/))) [, y, m, d] = match;\n  else if ((match = s.match(/^(\\d{1,2})[-/.](\\d{1,2})[-/.](\\d{4})$/))) [, d, m, y] = match;\n  else { issues.push(`Invalid date: ${v || 'empty'}`); return s || 'UNKNOWN'; }\n\n  const date = new Date(Date.UTC(+y, +m - 1, +d));\n  if (date.getUTCDate() !== +d || date.getUTCMonth() !== +m - 1) {\n    issues.push(`Invalid date: ${v}`);\n    return s;\n  }\n  return `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;\n}\n\n// ---------- main ----------\nitems.forEach((item, index) => {\n  const raw = getRaw(item.json);\n  const issues = [];\n\n  try {\n    const s = parseAI(raw);\n\n    const clean = {\n      Student_ID:    s.Student_ID ? String(s.Student_ID).trim().toUpperCase() : 'MISSING',\n      Name:          titleCase(s.Name),\n      Email:         cleanEmail(s.Email, issues),\n      Phone:         cleanPhone(s.Phone, issues),\n      Course:        titleCase(s.Course),\n      Fee_Paid:      cleanBool(s.Fee_Paid, issues),\n      City:          titleCase(s.City),\n      Enrolled_Date: cleanDate(s.Enrolled_Date, issues),\n    };\n\n    // Flag missing / placeholder values in text fields\n    ['Student_ID', 'Name', 'Course', 'City'].forEach(f => {\n      if (isPlaceholder(clean[f])) issues.push(`Missing ${f}`);\n    });\n\n    results.push({\n      json: {\n        ...clean,\n        Is_Valid: issues.length === 0,\n        Issues: issues.join('; '),\n      },\n      pairedItem: { item: index },\n    });\n  } catch (err) {\n    results.push({\n      json: {\n        Student_ID: 'PARSE_ERROR',\n        Is_Valid: false,\n        Issues: `Parse error: ${err.message}`,\n        Raw_Output: typeof raw === 'string' ? raw : JSON.stringify(raw),\n      },\n      pairedItem: { item: index },\n    });\n  }\n});\n\nreturn results;"
      },
