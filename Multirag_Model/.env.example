# Copy to .env and fill in. Never commit .env.

# --- OpenAI (required) ---
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# --- Neo4j (optional; enables hybrid+graph). Aura uses neo4j+s:// (TLS verified) ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=...
NEO4J_DATABASE=neo4j

# --- LangSmith tracing ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=hybrid-rag-pdf
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Retrieval: vector | bm25 | hybrid | hybrid+graph ---
RETRIEVAL_MODE=hybrid+graph
TOP_K=5
PER_RETRIEVER_K=10
RRF_K=60
CHUNK_SIZE=900
CHUNK_OVERLAP=150
NEIGHBOUR_WINDOW=1
CATEGORY_FIELD=department

# --- Optional website crawl ---
SOURCE_WEBSITE=
CRAWL_MAX_PAGES=30
CRAWL_DELAY=1.0

# --- Optional: extra CA bundle for sites with incomplete certificate chains ---
# CA_BUNDLE=certs/extra-ca.pem
