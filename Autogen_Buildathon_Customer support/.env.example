# =============================================================================
# Customer Support Agent - configuration
# Copy this file to .env and fill in the values marked REQUIRED.
# Never commit .env: it holds your keys (it is listed in .gitignore).
# Relative paths resolve against the project folder.
# =============================================================================

# ---------- OpenAI (REQUIRED) ----------
OPENAI_API_KEY=sk-...your-key...
OPENAI_CHAT_MODEL=gpt-4o-mini            # planner, answers, re-ranking (LangChain ChatOpenAI)
OPENAI_AGENT_MODEL=gpt-4o-mini           # the four AutoGen agents
OPENAI_JUDGE_MODEL=gpt-4o-mini           # LLM judge (confidence + evaluation); a stronger model is a stricter judge
OPENAI_VISION_MODEL=gpt-4o               # OCR of images inside the .docx files
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ---------- LangSmith tracing (optional) ----------
# Leave the key empty to switch tracing off.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=buildathon-support-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------- Neo4j knowledge graph (optional; without it retrieval runs as hybrid) ----------
# Neo4j Aura: copy the URI and password from the credentials file Aura gave you.
# Local: docker compose up -d  ->  bolt://localhost:7687
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
GRAPH_ENABLED=true

# ---------- Data and storage ----------
DATA_DIR=data                            # one sub-folder per product with its .docx files
INDEX_DIR=storage/indexes                # FAISS + BM25 indexes (built by: python -m support_agent.ingest)
CACHE_DIR=storage/cache                  # cached summaries / OCR / graph extraction
MEMORY_DB_PATH=storage/support_memory.db # long-term memory (SQLite)
TICKET_LOG_CSV=storage/ticket_log.csv    # CSV mirror of the Google Sheet log
# Corporate proxy with its own root CA? Point to its PEM bundle (TLS verification stays ON).
# CA_BUNDLE=C:/certs/corporate-root.pem

# ---------- Retrieval ----------
RETRIEVAL_MODE=hybrid+graph              # vector | bm25 | hybrid | hybrid+graph
CHUNK_SIZE=900
CHUNK_OVERLAP=120
TOP_K_PER_RETRIEVER=8
RRF_K=60
RAG_FUSION_QUERIES=3
RERANK_ENABLED=true
MIN_RERANK_SCORE=3.0                     # 0-10; passages below are dropped
FINAL_CONTEXT_K=5
OCR_ENABLED=true

# ---------- Agents and escalation ----------
CONFIDENCE_THRESHOLD=0.70                # below this the reply needs human approval
APPROVAL_TIMEOUT_SECONDS=600             # how long the agent team waits for a human decision
MAX_AGENT_MESSAGES=14                    # safety limit for the AutoGen group chat
MAX_COMPLAINT_CHARS=4000

# ---------- Email (Gmail) ----------
# Use a Gmail App Password (Google Account > Security > 2-Step Verification > App passwords),
# never the normal account password.
EMAIL_ENABLED=true
SUPPORT_MAILBOX=support-inbox@gmail.com
SUPPORT_MAILBOX_APP_PASSWORD=xxxx xxxx xxxx xxxx
ESCALATION_EMAIL=support-team@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com
MAIL_POLL_SECONDS=60
# Which incoming mails become tickets
MAIL_SUPPORT_ALIAS=support               # mails to <mailbox>+support@gmail.com are always accepted
MAIL_REQUIRE_SUPPORT_ALIAS=false         # true = ONLY +support mails become tickets
MAIL_ACCEPT_ALL=false                    # true = every non-bulk mail becomes a ticket
MAIL_PROCESS_EXISTING=false              # false = ignore mail already in the inbox at first start
MAIL_MAX_PER_POLL=10
# MAIL_ACCEPT_KEYWORDS=refund,order,warranty,...   # optional: overrides the built-in keyword list

# ---------- Customer confirmation ----------
CONFIRMATION_TIMEOUT_HOURS=48            # no answer within this time -> Closed - No Response
CONFIRMATION_SWEEP_MINUTES=30
SUPPORT_SITE_URL=http://localhost:8501   # link shown to customers for 'My tickets'

# ---------- Branding / time ----------
COMPANY_NAME=Your Company Support
TIMEZONE=Asia/Kolkata                    # IST timestamps in the log

# ---------- Google Sheets ticket log (optional; CSV is always written) ----------
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/google-service-account.json
GOOGLE_SHEET_ID=                         # the long ID in the sheet URL (share the sheet with the service account)
GOOGLE_SHEET_TAB=TicketLog

# ---------- Admin console / API ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Learning                  # Buildathon demo password (from the brief); change it for any real deployment
ADMIN_TOKEN_SECRET=                      # any long random string, e.g. python -c "import secrets;print(secrets.token_hex(32))"
API_BASE_URL=http://127.0.0.1:8000
